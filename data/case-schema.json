{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mohs-recon-ninja.local/case-schema.json",
  "title": "Mohs Recon Ninja Case",
  "type": "object",
  "required": ["caseId", "title", "module", "status", "difficulty", "vignette", "images", "answers", "feedback"],
  "properties": {
    "caseId": {"type":"string","pattern":"^nasal_[0-9]{3}$"},
    "title": {"type":"string","minLength":1},
    "module": {"const":"nose"},
    "status": {"enum":["draft","reviewed","final"]},
    "difficulty": {"enum":["easy","moderate","advanced"]},
    "vignette": {
      "type":"object",
      "required":["text","defectSize","laterality","depth","cartilageStatus","patientContext"]
    },
    "images": {"type":"array","minItems":1},
    "answers": {
      "type":"object",
      "required":["subunits","structuralRequirement","preferredReconstruction"]
    },
    "feedback": {
      "type":"object",
      "required":["preferredLabel","preferredRationale","acceptableAlternatives","teachingPearl"]
    }
  }
}
